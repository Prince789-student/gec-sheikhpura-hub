# ==============================================================================
# GEC Sheikhpura Student Life Hub - Environment Configuration Example
# Copy this file to .env or configure these variables in your hosting provider
# DO NOT COMMIT SENSITIVE SECRETS OR SERVICE-ROLE KEYS TO SOURCE CONTROL
# ==============================================================================

# 1. Supabase Project Client Configuration (Public / Safe for Frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-public-anon-key-placeholder

# 2. Supabase Server / Edge Functions Only (NEVER expose to frontend bundles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# 3. Transactional Email Provider (Optional - for future automated email notifications)
# Supported options: Supabase Auth SMTP, Resend, SendGrid, Amazon SES
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key-placeholder
SMTP_FROM_EMAIL=notifications@gecsheikhpura.ac.in

# 4. Web Push Notifications (Optional - for browser device alerts)
# Generated using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-placeholder
VAPID_PRIVATE_KEY=your-vapid-private-key-placeholder
VAPID_SUBJECT=mailto:admin@gecsheikhpura.ac.in

# 5. External Academic Platform Reference (Strict Platform Separation)
APNA_COLLEGE_BIHAR_URL=https://www.apnacollegebihar.online/
