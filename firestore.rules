rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public listings and content
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Student profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'pk3334238@gmail.com');
    }
    // Default fallback: Read allowed, writes strictly protected
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'pk3334238@gmail.com';
    }
  }
}

