{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gec-sheikhpura-backend.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://gec-sheikhpura-backend.onrender.com/health"
    },
    {
      "source": "/app",
      "destination": "/mobile_app/build/web/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/mobile_app/build/web/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
