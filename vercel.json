{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://gec-sheikhpura-backend.onrender.com/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://gec-sheikhpura-backend.onrender.com/health"
    },
    {
      "src": "/app/(.*)",
      "dest": "/mobile_app/build/web/$1"
    },
    {
      "src": "/app",
      "dest": "/mobile_app/build/web/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
